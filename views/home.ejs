<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce App</title>
    <link rel="stylesheet" href="./Assests/stylesheet/home.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    </head>
<body>

    <header class="text-light p-4" id="header">
        <div class="row align-items-center">
            <div class="col-6">
                <h1 class="mb-0 text-white">E-commerce</h1>
            </div>
            <div class="col-5 text-end">
                <div class="dropdown d-inline">
                    <button class="btn bg-dark"><a class="nav-link text-white" href="/allproducts">All
                            Products</a></button>
                            <button  class="btn bg-info"><a class="nav-link text-light" href="/cartRouter">My Cart</a></button>
                 
                </div>
                <a class="btn btn-success ms-2" href="signup">Sign Up</a>
                <a class="btn btn-warning ms-2" href="login">Log In</a>
            </div>
            <div class="col-1">
               <a href="/logout"><button class="btn btn-danger">LogOut</button></a>
            </div>
        </div>
        </div>
    </header>
    <section>
       <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <div class="d-flex justify-content-center py-5">
                    <h1 >Welcome To MY E-Commerce Website</h1>
                </div>
            </div>
        </div>
       </div>
      <div class="container">
        <div class="row">
            <% if (allProducts.length> 0) { %>
                <%allProducts.forEach(product=> { %>
                    <div class="col-sm-3 p-3">
                        <div class="card" id="card">
                            <div class="overflow-hidden d-flex justify-content-center" >
                                <img  src="<%=product.imageurl %>"id="img" class="card-img-top img-fluid"
                                    alt="Product Image">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= product.name %>
                                </h5>
                                <h5 class="card-text text-success">$<%=product.price %>
                                </h5>
                                <h6 class="description">
                                    <%=product.desc %>
                                </h6>
                                <h6 class="catagory">Catagory:- <%= product.category %>
                                </h6>
                               <div class="d-flex gap-2">
                             <% if (UserRole == 'ADMIN') { %>
                                <button class="btn btn-info"> <a class="nav-link text-white"
                                    href="/allProducts/edit/<%= product._id %>">Edit</a></button>
                            <button class="btn btn-danger"> <a class="nav-link text-white"
                                    href="/allProducts/delete/<%= product._id %>">Delete</a></button>
                             <% } %>
                                    
                                <a href="/cartRouter/<%= product._id %>" class="btn btn-primary">Add to Cart</a> 
                               </div>  
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <h1>No products found</h1>
                            <% } %>
        </div>
      </div>
    </section>
    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>